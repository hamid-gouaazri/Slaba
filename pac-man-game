class Pacman:
    def __init__(self):
        self.x = 13.5 * TILE_SIZE
        self.y = 23 * TILE_SIZE
        self.speed = 2
        self.direction = [0, 0]
        self.next_direction = [0, 0]

    def move(self):
        # Check if we can change direction
        if self.next_direction != [0, 0]:
            next_x = self.x + self.next_direction[0] * self.speed
            next_y = self.y + self.next_direction[1] * self.speed
            if self.is_clear(next_x, next_y, self.next_direction):
                self.direction = self.next_direction

        # Move in current direction
        new_x = self.x + self.direction[0] * self.speed
        new_y = self.y + self.direction[1] * self.speed

        if self.is_clear(new_x, new_y, self.direction):
            self.x = new_x
            self.y = new_y

        # Screen wrapping (Left/Right tunnels)
        if self.x < 0:
            self.x = WIDTH - TILE_SIZE
        elif self.x > WIDTH:
            self.x = 0

    def is_clear(self, x, y, direction):
        # Check collision with walls around the grid corners
        for offset_x in (0, TILE_SIZE - 2):
            for offset_y in (0, TILE_SIZE - 2):
                check_x = int((x + offset_x) // TILE_SIZE)
                check_y = int((y + offset_y) // TILE_SIZE)
                if 0 <= check_y < len(MAP) and 0 <= check_x < len(MAP[0]):
                    if MAP[check_y][check_x] == 1:
                        return False
                else:
                    return True
        return True

    def draw(self):
        pygame.draw.circle(screen, YELLOW, (int(self.x + TILE_SIZE // 2), int(self.y + TILE_SIZE // 2)), TILE_SIZE // 2)

class Ghost:
    def __init__(self, x, y, color):
        self.x = x * TILE_SIZE
        self.y = y * TILE_SIZE
        self.color = color
        self.speed = 2
        self.direction = random.choice([[0, 1], [0, -1], [1, 0], [-1, 0]])

    def move(self):
        new_x = self.x + self.direction[0] * self.speed
        new_y = self.y + self.direction[1] * self.speed

        if self.is_clear(new_x, new_y):
            self.x = new_x
            self.y = new_y
        else:
            # Pick a new random direction upon hitting a wall
            self.direction = random.choice([[0, 1], [0, -1], [1, 0], [-1, 0]])

    def is_clear(self, x, y):
        for offset_x in (2, TILE_SIZE - 2):
            for offset_y in (2, TILE_SIZE - 2):
                check_x = int((x + offset_x) // TILE_SIZE)
                check_y = int((y + offset_y) // TILE_SIZE)
                if 0 <= check_y < len(MAP) and 0 <= check_x < len(MAP[0]):
                    if MAP[check_y][check_x] == 1:
                        return False
        return True

    def draw(self):
        pygame.draw.circle(screen, self.color, (int(self.x + TILE_SIZE // 2), int(self.y + TILE_SIZE // 2)), TILE_SIZE // 2)

# Game Setup
pacman = Pacman()
ghosts = [Ghost(13, 11, RED), Ghost(14, 11, (255, 182, 255))]
score = 0
game_over = False

# Main Game Loop
while True:
    screen.fill(BLACK)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_LEFT:
                pacman.next_direction = [-1, 0]
            elif event.key == pygame.K_RIGHT:
                pacman.next_direction = [1, 0]
            elif event.key == pygame.K_UP:
                pacman.next_direction = [0, -1]
            elif event.key == pygame.K_DOWN:
                pacman.next_direction = [0, 1]

    if not game_over:
        pacman.move()
        for ghost in ghosts:
            ghost.move()

            # Check collision with ghosts
            if abs(pacman.x - ghost.x) < 10 and abs(pacman.y - ghost.y) < 10:
                game_over = True

        # Eat pellets
        p_row = int((pacman.y + TILE_SIZE // 2) // TILE_SIZE)
        p_col = int((pacman.x + TILE_SIZE // 2) // TILE_SIZE)
        if 0 <= p_row < len(MAP) and 0 <= p_col < len(MAP[0]):
            if MAP[p_row][p_col] == 0:
                MAP[p_row][p_col] = 2
                score += 10

    # Draw Map and Pellets
    for row_idx, row in enumerate(MAP):
        for col_idx, tile in enumerate(row):
            if tile == 1:
                pygame.draw.rect(screen, BLUE, (col_idx * TILE_SIZE, row_idx * TILE_SIZE, TILE_SIZE, TILE_SIZE))
            elif tile == 0:
                pygame.draw.circle(screen, WHITE, (col_idx * TILE_SIZE + TILE_SIZE // 2, row_idx * TILE_SIZE + TILE_SIZE // 2), 3)

    # Draw Characters
    pacman.draw()
    for ghost in ghosts:
        ghost.draw()

    # Draw Score
    font = pygame.font.SysFont(None, 24)
    score_text = font.render(f"Score: {score}", True, WHITE)
    screen.blit(score_text, (10, HEIGHT - 35))

    if game_over:
        game_over_text = font.render("GAME OVER - Press Close to Exit", True, RED)
        screen.blit(game_over_text, (WIDTH // 2 - 120, HEIGHT // 2))

    pygame.display.flip()
    clock.tick(FPS)
